{
  "name": "Separate",
  "description": "Separates a character column (text) into multiple columns using a regular expression or numeric locations.",
  "tags": [
    "preprocessing",
    "text processing"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/separate_operator"
  ],
  "properties": [
    {
      "kind": "StringProperty",
      "name": "into",
      "defaultValue": "col1,col2",
      "description": "Comma separated names of new variables."
    },
    {
      "kind": "StringProperty",
      "name": "sep",
      "defaultValue": "[_]",
      "description": "Separator between columns."
    }
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "1.0.0",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "Row",
            "type": "",
            "description": "Row factor containing the text to separate (exactly one required)",
            "ontologyMapping": "variable",
            "crosstabMapping": "row",
            "cardinality": "1",
            "factors": []
          }
        ],
        "axis": []
      }
    ],
    "outputSpecsV2": [
      {
        "kind": "OperatorJoinSpec",
        "description": "Output columns are dynamically created based on 'into' property",
        "joinOperators": [
          {
            "kind": "JoinOperator",
            "joinType": "left",
            "leftPair": {
              "kind": "ColumnPair",
              "lColumns": [
                "Row"
              ],
              "rColumns": [
                "Row"
              ]
            },
            "rightRelation": {
              "kind": "TableRelation",
              "meta_data": [
                {"kind": "Pair", "key": "allowAdditionalAttributes", "value": "true"}
              ],
              "attributes": []
            }
          }
        ]
      }
    ]
  }
}