{
  "name": "Separate",
  "description": "Separates a character column (text) into multiple columns using a regular expression or numeric locations.",
  "tags": [
    "preprocessing",
    "text processing"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/separate_operator"
  ],
  "properties": [
    {
      "kind": "StringProperty",
      "name": "into",
      "defaultValue": "col1,col2",
      "description": "Comma separated names of new variables."
    },
    {
      "kind": "StringProperty",
      "name": "sep",
      "defaultValue": "[_]",
      "description": "Separator between columns."
    }
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "Character Column",
            "type": "",
            "description": "A single character column to be separated.",
            "ontologyMapping": "variable",
            "crosstabMapping": "row",
            "cardinality": "1",
            "factors": []
          }
        ],
        "axis": []
      }
    ]
  }
}